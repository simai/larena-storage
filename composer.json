{
    "name": "larena/storage",
    "description": "Larena Storage: Universal dynamic data storage layer for typed schemas, records, lists, query boundaries, persistence profiles, validation pipelines and portable SitePack-compatible data models.",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Rim Zabarov",
            "homepage": "https://github.com/zabarov"
        }
    ],
    "require": {
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "larena/access": "dev-main",
        "larena/audit": "dev-main",
        "larena/property": "dev-main",
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Larena\\Storage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Larena\\Storage\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../access",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../audit",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../property",
            "options": {
                "symlink": true,
                "versions": {
                    "larena/property": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../core",
            "options": {
                "symlink": true,
                "versions": {
                    "larena/core": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../licensing",
            "options": {
                "symlink": true,
                "versions": {
                    "larena/licensing": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../ui",
            "options": {
                "symlink": true,
                "versions": {
                    "larena/ui": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../*",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "test": [
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/AccessScopedStorageRuntimeTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/InMemoryStorageRuntimeTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/LaravelDatabaseStorageAdapterContractTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/PdoLocalDevStorageAdapterTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/StorageAuditEmissionTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/StorageFailsClosedTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/StoragePersistenceFailClosedTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/StorageSchemaContractTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Unit/StorageTransactionBoundaryTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Integration/StorageOwnedTableShapeTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Integration/StorageSchemaMigrationTableShapeTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Integration/StorageSchemaEvolutionTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Integration/StorageSchemaEvolutionAdversarialTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Integration/StorageSchemaEvolutionOwnerProtectionTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Integration/StorageSchemaEvolutionOwnerPolicyProviderOrderTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Integration/StorageSchemaEvolutionConcurrencyTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Integration/StorageSchemaEvolutionMySqlTest.php",
            "php -d zend.assertions=1 -d assert.exception=1 tests/Integration/VersionedStorageDatabaseTest.php"
        ],
        "test:mysql-schema-evolution": "LARENA_STORAGE_SCHEMA_EVOLUTION_MYSQL_TEST=1 php -d zend.assertions=1 -d assert.exception=1 tests/Integration/StorageSchemaEvolutionMySqlTest.php",
        "test:unit": [
            "@test"
        ],
        "lint": "php scripts/lint.php",
        "analyse": "php scripts/analyse.php",
        "validate:larena": "php scripts/validate-larena-package.php",
        "evidence:check": "php scripts/check-evidence.php",
        "scope:check": "php tools/larena-scope-check.php",
        "quality:gate": [
            "@validate:larena",
            "@lint",
            "@analyse",
            "@test",
            "@larena:metadata:check",
            "@evidence:check",
            "@scope:check"
        ],
        "larena:metadata:check": "php scripts/check-metadata-sync.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {},
        "platform": {
            "php": "8.3.31"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Larena\\Storage\\Providers\\StorageServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
